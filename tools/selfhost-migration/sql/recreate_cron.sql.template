-- Rendered by tools/selfhost-migration/render_cron.py — the rendered file
-- contains the service-role key and must be 0600, never committed, and
-- deleted after use (docs/05 §4.8).
--
-- Mirrors supabase/schedule_audit_rotation.sql and
-- supabase/schedule_weekly_sales_report.sql with the self-hosted function URL.
-- Functions base URL: {{FUNCTIONS_BASE_URL}}
--
-- Run inside the db container, e.g.
--   docker compose exec -T db psql -U supabase_admin -d postgres -v ON_ERROR_STOP=1 -f /tmp/recreate_cron.sql

CREATE EXTENSION IF NOT EXISTS pg_cron;

-- Restored cron.job rows (if any) carry the hosted URL and a scrubbed/old key.
-- scrub_dump.py drops the cron.job COPY block, so this is normally a no-op;
-- it is kept so re-running the file is always safe.
SELECT cron.unschedule(jobid) FROM cron.job WHERE jobname IN ('rotate-audit-log', 'weekly-sales-report');

-- 1. Audit-log rotation: every 5 minutes (supabase/schedule_audit_rotation.sql)
SELECT cron.schedule(
  'rotate-audit-log',
  '*/5 * * * *',  -- every 5 minutes
  $$
  SELECT net.http_post(
    url     := '{{FUNCTIONS_BASE_URL}}/rotate-audit-log',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'Authorization', 'Bearer {{SERVICE_ROLE_KEY}}'
    ),
    body    := '{}'::jsonb
  );
  $$
);

-- 2. Weekly sales report: 17:30 UTC every Sunday == Monday 00:00 Asia/Yangon
--    (supabase/schedule_weekly_sales_report.sql). cron.timezone must be UTC.
SELECT cron.schedule(
  'weekly-sales-report',
  '30 17 * * 0',  -- 17:30 UTC every Sunday == Monday 00:00 Asia/Yangon (UTC+6:30)
  $$
  SELECT net.http_post(
    url     := '{{FUNCTIONS_BASE_URL}}/weekly-sales-report',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'Authorization', 'Bearer {{SERVICE_ROLE_KEY}}'
    ),
    body    := '{}'::jsonb
  );
  $$
);

SELECT jobid, jobname, schedule, active FROM cron.job ORDER BY jobname;   -- expect 2 rows
