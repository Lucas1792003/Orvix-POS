# /srv/supabase/backup/backup.env — non-secret configuration for the backup jobs.
# Sourced by backup-lib.sh. No secrets go here (POSTGRES_PASSWORD is read from
# /srv/supabase/stack/.env by backup-base.sh only when pg_basebackup over TCP is used).

STACK_DIR=/srv/supabase/stack
BACKUP_ROOT=/srv/supabase/backups
PG_IMAGE=supabase/postgres:17.6.1.136

# retention (count of directories kept, newest first)
KEEP_HOURLY=48
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_BASE=14

# logical dump size sanity: warn when the dump set grows/shrinks more than this vs the previous run
SIZE_WARN_PCT=50

# base backup method: auto (pg_basebackup if pg_hba allows replication, else sqlapi) | pg_basebackup | sqlapi
# pg_hba.conf carries the replication entry since 2026-10-11 (WAL-ARCHIVING.md): pin pg_basebackup so a
# regression fails loudly instead of silently falling back.
BASE_METHOD=pg_basebackup

# WAL archive (bind mount of the db container's /var/lib/postgresql/wal_archive) and the archive-lag threshold
WAL_ARCHIVE_DIR=/srv/supabase/stack/volumes/db/wal_archive
MAX_ARCHIVE_LAG_S=600
# store a copy of /etc/postgresql-custom/pgsodium_root.key next to each base backup (0600)
INCLUDE_PGSODIUM_KEY=true
GZIP_LEVEL=6

# throwaway restore containers
THROWAWAY_MEMORY=1g
THROWAWAY_READY_TIMEOUT=240
# allowed absolute difference for row counts (auth.users, storage.buckets, storage.objects) between
# the counts captured at backup time and the restored copy; schema table counts must always match exactly
RESTORE_COUNT_TOLERANCE=0

# backup-status.sh thresholds (seconds) and free-space floor
MAX_AGE_LOGICAL_S=7200
MAX_AGE_BASE_S=93600
MAX_AGE_RESTORE_S=691200
MIN_FREE_GB=20

# optional dead-man's switch (healthchecks.io ping URL). Leave empty to disable.
HEALTHCHECKS_URL=

# ---------------------------------------------------------------------------
# Offsite tier (Phase F, OFFSITE-ENABLE.md). Everything is inert until OFFSITE_ENABLED=true:
# offsite-sync.sh / secrets-bundle.sh / offsite-restore-test.sh / offsite-status.sh exit 0 with
# "offsite disabled". Flip the flag only after rclone.conf, AGE_RECIPIENT and the first dry-run are done.
# ---------------------------------------------------------------------------
OFFSITE_ENABLED=false
# rclone config created by the owner with `rclone config --config /srv/supabase/backup/rclone.conf` (0600, lucario).
# Contains the R2 token and the obscured crypt password/salt — never copied anywhere but the bundle.
RCLONE_CONFIG=/srv/supabase/backup/rclone.conf
# crypt remote name + colon; base/ wal/ dump/ storage/ bundle/ .versions/ golden/ live under it
OFFSITE_REMOTE=offsite:
OFFSITE_STATUS_FILE=/srv/supabase/backups/offsite.json
STORAGE_DIR=/srv/supabase/stack/volumes/storage
BUNDLE_DIR=/srv/supabase/backups/bundle
KEEP_BUNDLE=14
# age PUBLIC key(s) of the owner (age1...), space-separated. The private key lives on the Mac + password manager only.
AGE_RECIPIENT=
DB_CONFIG_VOLUME=supabase_db-config
BUNDLE_TAR_MODE=docker
# rclone limits: --bwlimit (e.g. 4M, or a timetable "08:00,2M 22:00,off"; empty = unlimited), parallelism
OFFSITE_BWLIMIT=
OFFSITE_TRANSFERS=4
OFFSITE_CHECKERS=8
# verification after each sync: cryptcheck | check | none
OFFSITE_CHECK=cryptcheck
# --backup-dir versions (.versions/<tier>/<YYYYMMDD>) are purged after this many days by the daily check job
OFFSITE_VERSIONS_KEEP_DAYS=30
OFFSITE_SIZE_WARN_GB=8
OFFSITE_SIZE_HIGH_GB=9
# wal tier: incremental copy of segments newer than this every run; a full sync (applies the local prune) every N s
OFFSITE_WAL_COPY_MAX_AGE=24h
OFFSITE_WAL_FULL_EVERY_S=86400
# optional YYYY-MM-DD if the R2 token was created with a TTL; offsite-status warns 14 d before
R2_TOKEN_EXPIRES=
# offsite-status thresholds (seconds): wal 30 min, dump 2 h, base 26 h, storage 7 h, bundle 26 h, check 50 h, restore 8 d
MAX_AGE_OFFSITE_WAL_S=1800
MAX_AGE_OFFSITE_DUMP_S=7200
MAX_AGE_OFFSITE_BASE_S=93600
MAX_AGE_OFFSITE_STORAGE_S=25200
MAX_AGE_OFFSITE_BUNDLE_S=93600
MAX_AGE_OFFSITE_CHECK_S=180000
MAX_AGE_OFFSITE_RESTORE_S=691200
# healthchecks.io ping URLs (treated as secrets; leave empty to disable): "offsite" (every sync job) and
# "restore-test-offsite" (weekly). The Mac pull pings its own URL from the Mac (MAC-TIER.md).
HEALTHCHECKS_OFFSITE_URL=
HEALTHCHECKS_OFFSITE_RESTORE_URL=

# ---------------------------------------------------------------------------
# Email tier (Phase F, docs/selfhost-migration/phase-f/email-backup-design.md). Inert until
# EMAIL_ENABLED=true: email-archive.sh / email-report.sh exit 0 with "email tier disabled";
# email-status.sh prints one "disabled" line. Enable only via the owner checklist in that doc.
# No secrets in this file: the send-only OAuth token / API key / SMTP credential live in their own
# 0600 files owned by the backup user.
# ---------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_REPORT_ENABLED=false
# gmail-api = Gmail API users.messages.send from a dedicated SENDER Gmail, OAuth scope gmail.send ONLY
#             (recommended without a domain; credential minted by gmail-oauth-mint.py on the owner's Mac);
# resend    = HTTPS API with a sending_access key restricted to the sender domain;
# smtp      = curl SMTP with a send-only credential (fallback provider). Never a mailbox's own password,
#             never a Gmail app password.
MAIL_TRANSPORT=gmail-api
# gmail-api: the sender Gmail address the token was minted for; MAIL_FROM defaults to
# "POS backups <GMAIL_SENDER>" and must use that address (Gmail sends as the authenticated account)
GMAIL_SENDER=
GMAIL_OAUTH_FILE=/srv/supabase/backup/credentials/gmail-oauth.json
MAIL_FROM=
# the dedicated BACKUP mailbox (a different Gmail; its login never touches this host); failures go to ALERT_MAIL_TO
ARCHIVE_MAIL_TO=
ALERT_MAIL_TO=
RESEND_KEY_FILE=/srv/supabase/backup/credentials/resend.key
SMTP_URL=
SMTP_NETRC_FILE=/srv/supabase/backup/credentials/smtp.netrc
# owner's OpenPGP PUBLIC key (armored) and its pinned 40-hex fingerprint
ARCHIVE_GPG_PUBKEY=/srv/supabase/backup/credentials/owner-backup.pub.asc
ARCHIVE_GPG_FPR=
ARCHIVE_LABEL=pos
ARCHIVE_PART_BYTES=15728640
ARCHIVE_MAX_PARTS=12
ARCHIVE_WARN_PARTS=4
KEEP_EMAIL_ARCHIVE=4
# largest encoded message handed to any transport (Gmail: 25 MB personal send limit; the API's own
# upload maximum is 35 MiB and a larger value is refused for gmail-api). MAIL_MAX_BYTES is an alias.
MAIL_MAX_ENCODED_BYTES=24000000
# transient failures (429/5xx/rate limit): MAIL_RETRIES attempts, back-off 30 s, 60 s, ... capped
MAIL_RETRIES=3
MAIL_RETRY_SLEEP_S=30
MAIL_RETRY_MAX_SLEEP_S=300
# NEVER set GMAIL_TOKEN_URL / GMAIL_API_BASE here: they exist only for the local test harness and
# accept nothing but Google's URLs or 127.0.0.1.
# secrets file: off | local (build + keep on host) | email (also mail when the secret set changed)
EMAIL_SECRETS_MODE=local
REPORT_TARGETS_FILE=/srv/supabase/backup/report-targets.conf
REPORT_TZ=Asia/Yangon
