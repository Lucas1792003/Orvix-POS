{
  "name": "retails-shop",
  "private": true,
  "version": "1.0.16",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:electron": "tsc -b && cross-env ELECTRON_BUILD=true VITE_SUPABASE_EXPECTED_HOST=lucashome.tail8a86e4.ts.net vite build",
    "electron:build": "npm run build:electron && electron-builder",
    "electron:build:mac": "npm run build:electron && electron-builder --mac --x64 --arm64",
    "electron:build:win": "npm run build:electron && electron-builder --win --x64",
    "seed:service-role": "tsx scripts/seed/seedServiceRole.ts",
    "e2e": "playwright test",
    "e2e:cleanup": "tsx e2e/seed/cleanup.ts",
    "test:phone-modal": "node tools/phone-modal-harness/run.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.106.1",
    "dexie": "^4.4.5",
    "electron-updater": "^6.8.9",
    "jsbarcode": "^3.12.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.2.0",
    "recharts": "^3.7.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.7",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.shwephala.pos",
    "productName": "Shwe Pha La POS",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/test/**"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "electron/afterPack.cjs",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "artifactName": "Shwe-Pha-La-POS-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Shwe-Pha-La-POS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Lucas1792003",
      "repo": "ShwePhaLa"
    }
  }
}
