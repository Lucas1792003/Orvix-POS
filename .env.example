# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# All three are required for a production build (`npm run build`,
# `npm run build:electron`); see docs/07-setup-deployment.md and
# docs/deployment-safety.md.

# Supabase API base URL of the backend this build talks to.
VITE_SUPABASE_URL=https://your-backend.example.ts.net

# The backend's anon (public) key. Never put a service-role key in a VITE_* variable.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Host pin: must equal the host (and port, if any) of VITE_SUPABASE_URL.
# `vite build` refuses to build when this is unset or does not match.
VITE_SUPABASE_EXPECTED_HOST=your-backend.example.ts.net
